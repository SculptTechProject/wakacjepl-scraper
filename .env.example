# Firebase Installations configuration. No captured token or fixed FID is needed.
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
# Identify the client version explicitly; do not copy device identity headers.
FIREBASE_SDK_VERSION=

# The raw Authorization value from an authorized Wakacje API session.
# This is different from the Firebase installation token. Do not prepend Bearer.
WAKACJE_AUTHORIZATION=
# Optional UUID identifying this client; generated per run when omitted.
WAKACJE_DEVICE_ID=
